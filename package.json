{
  "name": "resumatch-ai-career-assistant",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "ResuMatch: resume analysis and job matching with Gemini, Express and SQLite",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
